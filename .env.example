# ==============================================================================
# Configurações do Cliente Edge FaceShield - Raspberry Pi 3B
# ==============================================================================

# URL da API de verificação no seu servidor central (ajuste com o IP do seu PC)
SERVER_URL=http://192.168.1.100:8000/api/v1/verify

# Identificador único deste ponto de captura
DEVICE_ID=pi-portaria-01

# Tipo de Câmera: 'usb' (webcam USB comum) ou 'picamera2' (módulo de câmera ribbon do Pi)
CAMERA_TYPE=usb

# Índice da câmera USB (geralmente 0 para /dev/video0)
CAMERA_INDEX=0

# Resolução de captura (640x480 é ideal para o Pi 3B)
FRAME_WIDTH=640
FRAME_HEIGHT=480

# Taxa de quadros almejada para captura
FPS_TARGET=10

# Qualidade do JPEG enviado (1 a 100). 80 equilibra nitidez e tamanho reduzido (< 40 KB)
JPEG_QUALITY=80

# Detecção de movimento ultraleve (1 = ativado, 0 = desativado)
# Quando ativado, só envia frames quando alguém se mover na frente da câmera.
MOTION_DETECTION_ENABLED=1

# Sensibilidade de movimento (20-30 é um bom intervalo)
MOTION_THRESHOLD=25

# Área mínima de pixels em movimento para considerar uma pessoa
MOTION_MIN_AREA=3000

# Intervalo mínimo (em segundos) entre envios ao servidor para a mesma cena
COOLDOWN_SECONDS=2.0

# Envio periódico de heartbeat/frame mesmo sem movimento (0 = desativado)
PERIODIC_INTERVAL_SECONDS=0.0

# Timeout da requisição HTTP ao servidor em segundos
REQUEST_TIMEOUT=6.0
